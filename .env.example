# Copy these into Vercel (Project > Settings > Environment Variables) and redeploy.
# Both values are in Supabase: Project Settings > API. The anon key is meant to be public; the table only lets it add rows.
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Bot check on the contact form (Cloudflare Turnstile).
# The site key is public and is baked in at build time. The secret key, the Supabase URL and the Supabase secret key are read by api/contact.js on Vercel.
# Put the SECRET values only in Vercel > Settings > Environment Variables, never in git.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
