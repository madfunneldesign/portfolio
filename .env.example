# Copy these into Vercel (Project > Settings > Environment Variables) and redeploy.
# Both values are in Supabase: Project Settings > API. The anon key is meant to be public; the table only lets it add rows.
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
