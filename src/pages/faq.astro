<Fragment slot="jsonld">
<script type="application/ld+json" id="faq-jsonld">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://www.madfunneldesign.com/faq#page",
      "url": "https://www.madfunneldesign.com/faq",
      "name": "Frequently asked questions",
      "description": "Straight answers about pricing, process, platforms and what is and isn’t included before you book a call with MAD Funnel Design.",
      "inLanguage": "en",
      "isPartOf": {
        "@id": "https://www.madfunneldesign.com/#website"
      },
      "author": {
        "@id": "https://www.madfunneldesign.com/#person"
      },
      "breadcrumb": {
        "@id": "https://www.madfunneldesign.com/faq#breadcrumb"
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://www.madfunneldesign.com/faq#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.madfunneldesign.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "FAQ",
          "item": "https://www.madfunneldesign.com/faq"
        }
      ]
    },
    {
      "@type": "Person",
      "@id": "https://www.madfunneldesign.com/#person",
      "name": "Aldrich Matthew Domingo",
      "alternateName": "Drich",
      "jobTitle": "Website, Landing Page and Funnel Designer",
      "url": "https://www.madfunneldesign.com/"
    },
    {
      "@type": "FAQPage",
      "@id": "https://www.madfunneldesign.com/faq#faq",
      "url": "https://www.madfunneldesign.com/faq",
      "name": "Frequently asked questions about MAD Funnel Design",
      "inLanguage": "en",
      "isPartOf": {
        "@id": "https://www.madfunneldesign.com/faq#page"
      },
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Who is MAD Funnel Design for?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "MAD Funnel Design is for coaches, consultants, creators and service-based businesses that need a website, landing page or sales funnel built around their offer. Aldrich Matthew designs and develops each project himself, from the page structure and visual design to the forms and automation behind it."
          }
        },
        {
          "@type": "Question",
          "name": "How much does a website or sales funnel cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Packages start at $850 USD for a single custom landing page. A multi-page website or defined sales funnel starts at $2,200, and a custom multi-page system for established businesses starts at $4,500. These are starting estimates; the final quote depends on scope and complexity. See the full package breakdown."
          }
        },
        {
          "@type": "Question",
          "name": "What is included in the $850 Web Essentials package?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Web Essentials covers one custom landing page with a conversion-focused structure, custom visual design, responsive desktop and mobile layouts, lead capture forms with basic integrations, basic on-page SEO setup, testing and deployment. Advanced GSAP and Lenis animation is available separately."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between a landing page and a sales funnel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A landing page is a single page built to get one action, such as a booking or an enquiry. A sales funnel is a connected sequence of pages and follow-up steps that guides a visitor from first interest to a sale or booked call. Which one fits depends on your offer and sales process."
          }
        },
        {
          "@type": "Question",
          "name": "Do you build with Systeme.io, GoHighLevel or custom code?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "All three. Projects are built with custom HTML, CSS and JavaScript, or on platforms such as Systeme.io, GoHighLevel and Shopify when the project calls for them. The choice depends on what you need to manage yourself, how your leads are handled, and how much control the design requires."
          }
        },
        {
          "@type": "Question",
          "name": "Can you connect my website to a CRM and automate follow-ups?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Lead capture forms can be connected to your CRM, with automated follow-up emails, pipeline stages and customer workflows set up behind them. Web & Conversion includes CRM integration and up to 2 automation workflows; Web Systems covers advanced CRM integrations and multi-step workflows."
          }
        },
        {
          "@type": "Question",
          "name": "Is SEO included in my website?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, at a level that depends on the package. Web Essentials includes basic on-page SEO setup, Web & Conversion includes on-page SEO foundations, and Web Systems adds technical SEO. SEO supports how your site is found and understood, but no specific ranking or traffic result is guaranteed."
          }
        },
        {
          "@type": "Question",
          "name": "How does a project work from brief to launch?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Every project follows four steps: understanding your requirements, planning the structure and design, developing and connecting the site, then testing and launching it. You see the direction before development begins, and mobile, desktop, links, forms and integrations are checked before launch. Read the full process."
          }
        },
        {
          "@type": "Question",
          "name": "How long does a project take, and are revisions included?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Timelines and revision allowances depend on the scope, so they are set out in your written proposal before work starts. A single landing page and a multi-page system with automation are very different projects, which is why a fixed number would not be accurate for everyone."
          }
        },
        {
          "@type": "Question",
          "name": "Are hosting, domains and subscriptions included in the price?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No, unless your proposal says otherwise. Hosting, domain names, third-party subscriptions and paid integrations are billed separately by their providers. Prices cover the design, development, setup and deployment work."
          }
        },
        {
          "@type": "Question",
          "name": "Do you guarantee leads, sales or search rankings?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. A well-structured website and funnel makes it easier for visitors to understand your offer and take the next step, but results also depend on your offer, traffic, pricing and market. No lead, revenue, conversion or ranking outcome is guaranteed."
          }
        },
        {
          "@type": "Question",
          "name": "Do you work with clients outside the Philippines?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Aldrich is based in the Philippines and works with coaches and service-based businesses worldwide. Pricing is in USD, and projects are handled online. The easiest way to start is to book a free 15-minute call."
          }
        }
      ]
    }
  ]
}
  </script>
