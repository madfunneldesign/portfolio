---
import Base from "../layouts/Base.astro";
import Contact from "../components/Contact.astro";
---
<Base bodyClass="page-about" current="about">
<Fragment slot="meta">
<title>About Aldrich Matthew | Website &amp; Funnel Designer | MAD Funnel Design</title>
  <meta name="description" content="Aldrich Matthew is an independent website designer and developer in the Philippines. He builds business websites, landing pages, funnels and CRM automation for coaches and service businesses.">
  <link rel="canonical" href="https://www.madfunneldesign.com/about">
  <meta name="author" content="Aldrich Matthew Domingo">
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
  <meta name="theme-color" content="#1C1C1C">

  <meta property="og:type" content="profile">
  <meta property="og:site_name" content="MAD Funnel Design">
  <meta property="og:url" content="https://www.madfunneldesign.com/about">
  <meta property="og:title" content="About Aldrich Matthew | Website &amp; Funnel Designer | MAD Funnel Design">
  <meta property="og:description" content="An independent website designer and developer who builds the pages people see and the systems that handle what happens after they visit.">
  <meta property="og:image" content="https://www.madfunneldesign.com/assets/img/og.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="MAD Funnel Design: website and funnel design for coaches and service businesses">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="About Aldrich Matthew | Website &amp; Funnel Designer">
  <meta name="twitter:description" content="An independent website designer and developer based in the Philippines.">
  <meta name="twitter:image" content="https://www.madfunneldesign.com/assets/img/og.png">
</Fragment>
<Fragment slot="jsonld">
<script type="application/ld+json">
