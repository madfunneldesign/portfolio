---
import Base from "../layouts/Base.astro";
import Contact from "../components/Contact.astro";
---
<Base bodyClass="page-about page-contact" current="contact">
<Fragment slot="meta">
<title>Contact MAD Funnel Design | Book a Free Strategy Call</title>
  <meta name="description" content="Get in touch with MAD Funnel Design about a website, landing page, sales funnel or connected marketing system. Book a free strategy call or send a project inquiry.">
  <link rel="canonical" href="https://www.madfunneldesign.com/contact">
  <meta name="author" content="Aldrich Matthew Domingo">
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
  <meta name="theme-color" content="#1C1C1C">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="MAD Funnel Design">
  <meta property="og:url" content="https://www.madfunneldesign.com/contact">
  <meta property="og:title" content="Contact | MAD Funnel Design">
  <meta property="og:description" content="Book a free strategy call or send a project inquiry.">
  <meta property="og:image" content="https://www.madfunneldesign.com/assets/img/og.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="MAD Funnel Design: website and funnel design for coaches and service businesses">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Contact | MAD Funnel Design">
  <meta name="twitter:description" content="Book a free strategy call or send a project inquiry.">
  <meta name="twitter:image" content="https://www.madfunneldesign.com/assets/img/og.png">
</Fragment>
<Fragment slot="jsonld">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ContactPage",
      "@id": "https://www.madfunneldesign.com/contact#page",
      "url": "https://www.madfunneldesign.com/contact",
      "name": "Contact MAD Funnel Design",
      "description": "Get in touch with MAD Funnel Design about a website, landing page, sales funnel or connected marketing system. Book a free strategy call or send a project inquiry.",
      "inLanguage": "en",
      "isPartOf": {
        "@id": "https://www.madfunneldesign.com/#website"
      },
      "author": {
        "@id": "https://www.madfunneldesign.com/#person"
      },
      "breadcrumb": {
        "@id": "https://www.madfunneldesign.com/contact#breadcrumb"
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://www.madfunneldesign.com/contact#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.madfunneldesign.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Contact",
          "item": "https://www.madfunneldesign.com/contact"
        }
      ]
    },
    {
      "@type": "Person",
      "@id": "https://www.madfunneldesign.com/#person",
      "name": "Aldrich Matthew Domingo",
      "alternateName": "Drich",
      "jobTitle": "Website, Landing Page and Funnel Designer",
      "url": "https://www.madfunneldesign.com/"
    }
  ]
}
  </script>
</Fragment>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M4 12h15M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></symbol>
      <symbol id="i-down-right" viewBox="0 0 24 24"><path d="M5 5l13 13M18 8v10H8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
      <symbol id="i-check" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M7.6 12.4l3 3 5.8-6.2" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></symbol>
    </svg>

    <section class="hero hero-about hero-services hero-legal" aria-labelledby="contact-title">
      <span class="hbar hbar-1" aria-hidden="true"></span>
      <span class="hbar hbar-2" aria-hidden="true"></span>
      <span class="hbar hbar-3" aria-hidden="true"></span>
      <span class="hbar hbar-4" aria-hidden="true"></span>

      <div class="ah-copy">
        <p class="ah-label" data-reveal>Contact</p>
        <h1 id="contact-title" data-speakable>
          <span class="line">Let&rsquo;s talk</span>
          <span class="line">about the</span>
          <span class="line">build.</span>
        </h1>
        <p class="ah-intro" data-reveal data-speakable>Tell me what you&rsquo;re looking to build, what isn&rsquo;t working, or what you need to connect. I&rsquo;ll review it and get back to you with a practical next step.</p>
      </div>

      <nav class="svc-index" aria-label="Related pages">
        <ol>
          <li data-reveal><a href="https://calendly.com/-aldrichmatthew/15mins"><span class="si-n">Book</span><span class="si-t">A free 15-minute call</span><svg width="22" height="22" aria-hidden="true"><use href="#i-down-right"/></svg></a></li>
          <li data-reveal><a href="mailto:madfunneldesign@gmail.com"><span class="si-n">Write</span><span class="si-t">madfunneldesign@gmail.com</span><svg width="22" height="22" aria-hidden="true"><use href="#i-down-right"/></svg></a></li>
          <li data-reveal><a href="tel:+639064888321"><span class="si-n">Call</span><span class="si-t">+63 906 488 8321</span><svg width="22" height="22" aria-hidden="true"><use href="#i-down-right"/></svg></a></li>
        </ol>
      </nav>
    </section>

    <Contact />
  
</Base>
