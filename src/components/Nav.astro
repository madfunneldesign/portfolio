---
const { current = "", home = "/" } = Astro.props;
---
<header class="nav" data-nav>
    <div class="nav-bar">
      <a class="brand" href="/" aria-label="MAD Funnel Design, home">
        <img class="logo logo-dark" src="assets/img/logo-dark.webp" alt="" width="320" height="320" decoding="async">
        <img class="logo logo-color" src="assets/img/logo-color.webp" alt="" width="320" height="320" decoding="async">
      </a>

      <nav class="nav-links" aria-label="Main">
        <a href="/about" aria-current={current === "about" ? "page" : undefined}>About</a>
        <a href="/services" aria-current={current === "services" ? "page" : undefined}>Services</a>
        <a href="/projects" aria-current={current === "projects" ? "page" : undefined}>Projects</a>
        <a href="/faq" aria-current={current === "faq" ? "page" : undefined}>FAQ&rsquo;s</a>
        <a href="/contact" aria-current={current === "contact" ? "page" : undefined}>Contact</a>
      </nav>

      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu" data-menu-btn>
        <span class="sr-only">Menu</span>
        <span class="menu-lines" aria-hidden="true"><i></i><i></i><i></i></span>
      </button>
    </div>
  </header>

  <div class="menu" id="menu" data-menu data-lenis-prevent role="dialog" aria-modal="true" aria-label="Menu" inert>
    <div class="menu-inner">
      <nav class="menu-links" aria-label="Menu">
        <a href="/services"><span data-m>Services</span></a>
        <a href={`${home}#pricing`}><span data-m>Pricing</span></a>
        <a href="/projects"><span data-m>Projects</span></a>
        <a href="/about"><span data-m>About</span></a>
        <a href="/faq"><span data-m>FAQ&rsquo;s</span></a>
        <a href="https://madfunneldesign.systeme.io/brand-identity-system-30-minutes"><span data-m>Brand System</span></a>
        <a href="/contact"><span data-m>Contact</span></a>
      </nav>

      <aside class="menu-pricing" aria-labelledby="menu-pricing-title">
        <h2 class="menu-k" id="menu-pricing-title" data-m>Pricing</h2>
        <ul class="menu-plans">
          <li data-m><a href={`${home}#web-essentials`}><span class="mp-name">Web Essentials</span><span class="mp-price">$850</span><span class="mp-for">A single custom landing page with a conversion-focused structure, responsive layouts and basic SEO.</span></a></li>
          <li data-m><a href={`${home}#web-conversion`}><span class="mp-name">Web &amp; Conversion</span><span class="mp-price">$2,200</span><span class="mp-for">A multi-page website (up to 5 pages) or a defined sales funnel, with CRM integration and up to 2 automations.</span></a></li>
          <li data-m><a href={`${home}#web-systems`}><span class="mp-name">Web Systems</span><span class="mp-price">$4,500</span><span class="mp-for">Custom multi-page build with advanced interactions, multi-step automations and technical SEO.</span></a></li>
        </ul>
        <p class="menu-note" data-m>Starting prices in USD. The final quote depends on scope and complexity.</p>
        <a class="cta cta-menu" data-m href="https://calendly.com/-aldrichmatthew/15mins"><span>Book Free Strategy Call</span><svg width="22" height="22" aria-hidden="true"><use href="#i-arrow"/></svg></a>
      </aside>

      <div class="menu-foot">
        <a href="/terms" data-m>Terms &amp; Conditions</a>
        <a href="/privacy" data-m>Privacy Policy</a>
        <a href="tel:+639064888321" data-m>+63 906 488 8321</a>
        <p data-m><span>Manila, PH</span> <time data-clock datetime="">--:--</time></p>
      </div>
    </div>
  </div>
