<section class="contact" id="contact" aria-labelledby="contact-title">
      <div class="contact-inner">
        <aside class="contact-side">
          <figure class="c-card" data-contact-fade>
            <img class="c-avatar" src="assets/img/aldrich-matthew.webp" alt="Aldrich Matthew" width="80" height="80" loading="lazy" decoding="async">
            <figcaption>
              <span class="c-name">Aldrich Matthew</span>
              <span class="c-role">Website &amp; Funnel Designer</span>
            </figcaption>
            <blockquote class="c-note">
              <p>I&rsquo;ll go through your project details and get back to you personally.</p>
            </blockquote>
          </figure>
          <div class="c-info" data-contact-fade>
            <p class="c-k">Prefer to talk?</p>
            <a class="c-big" href="https://calendly.com/-aldrichmatthew/15mins"><span>Book a free 15-minute call</span></a>
            <a class="c-mail" href="mailto:madfunneldesign@gmail.com">madfunneldesign@gmail.com</a>
            <p class="c-small">Based in the Philippines. Working with coaches and service businesses worldwide. Pricing in USD.</p>
          </div>
        </aside>

        <div class="contact-main">
          <h2 id="contact-title">Start a project.</h2>
          <p class="contact-lede" data-contact-fade data-speakable>Tell me a little about your business and what you need. Whether you have a full brief or just an idea, you&rsquo;ll get a clear next step, not a sales pitch.</p>

          <form class="cform" data-cform data-supabase-url={import.meta.env.PUBLIC_SUPABASE_URL} data-supabase-key={import.meta.env.PUBLIC_SUPABASE_ANON_KEY} method="post" action="mailto:madfunneldesign@gmail.com" data-endpoint="" data-email="madfunneldesign@gmail.com" novalidate>
            <p class="hp" aria-hidden="true"><label>Leave this empty <input type="text" name="company_site" tabindex="-1" autocomplete="off"></label></p>
            <div class="row">
              <div class="field"><label for="f-name">Full name</label><input id="f-name" name="name" type="text" autocomplete="name" placeholder="Aldrich Matthew" required></div>
              <div class="field"><label for="f-email">Your email address</label><input id="f-email" name="email" type="email" autocomplete="email" inputmode="email" placeholder="example@email.com" required></div>
            </div>
            <div class="row">
              <div class="field"><label for="f-biz">Business name</label><input id="f-biz" name="business" type="text" autocomplete="organization" placeholder="Your company"></div>
              <div class="field"><label for="f-site">Website (optional)</label><input id="f-site" name="website" type="text" inputmode="url" autocomplete="url" placeholder="yourwebsite.com"></div>
            </div>
            <div class="row">
              <div class="field field-select">
              <label id="lbl-project" for="btn-project">Your project</label>
              <div class="dd" data-dd>
                <input type="hidden" name="project" value="" required>
                <button class="dd-btn" type="button" id="btn-project" role="combobox" aria-haspopup="listbox" aria-expanded="false" aria-controls="list-project" aria-labelledby="lbl-project btn-project"><span class="dd-val" data-ph="Select one">Select one</span><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 9l7 7 7-7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square"/></svg></button>
                <ul class="dd-list" id="list-project" role="listbox" aria-labelledby="lbl-project" tabindex="-1"><li role="option" id="dd-project-0" data-value="Website design &amp; development">Website design &amp; development</li><li role="option" id="dd-project-1" data-value="Landing page &amp; sales funnel">Landing page &amp; sales funnel</li><li role="option" id="dd-project-2" data-value="Ecommerce website">Ecommerce website</li><li role="option" id="dd-project-3" data-value="Marketing automation &amp; CRM integration">Marketing automation &amp; CRM integration</li><li role="option" id="dd-project-4" data-value="Custom web development &amp; interactions">Custom web development &amp; interactions</li><li role="option" id="dd-project-5" data-value="Not sure yet, I need guidance">Not sure yet, I need guidance</li></ul>
              </div>
            </div>
              <div class="field field-select">
              <label id="lbl-budget" for="btn-budget">Budget</label>
              <div class="dd" data-dd>
                <input type="hidden" name="budget" value="" required>
                <button class="dd-btn" type="button" id="btn-budget" role="combobox" aria-haspopup="listbox" aria-expanded="false" aria-controls="list-budget" aria-labelledby="lbl-budget btn-budget"><span class="dd-val" data-ph="Select one">Select one</span><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 9l7 7 7-7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square"/></svg></button>
                <ul class="dd-list" id="list-budget" role="listbox" aria-labelledby="lbl-budget" tabindex="-1"><li role="option" id="dd-budget-0" data-value="Around $850">Around $850</li><li role="option" id="dd-budget-1" data-value="$850 to $2,200">$850 to $2,200</li><li role="option" id="dd-budget-2" data-value="$2,200 to $4,500">$2,200 to $4,500</li><li role="option" id="dd-budget-3" data-value="$4,500 and above">$4,500 and above</li><li role="option" id="dd-budget-4" data-value="Not sure yet">Not sure yet</li></ul>
              </div>
            </div>
            </div>
            <div class="field field-select">
              <label id="lbl-timeline" for="btn-timeline">When are you looking to get started?</label>
              <div class="dd" data-dd>
                <input type="hidden" name="timeline" value="" required>
                <button class="dd-btn" type="button" id="btn-timeline" role="combobox" aria-haspopup="listbox" aria-expanded="false" aria-controls="list-timeline" aria-labelledby="lbl-timeline btn-timeline"><span class="dd-val" data-ph="Select one">Select one</span><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 9l7 7 7-7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square"/></svg></button>
                <ul class="dd-list" id="list-timeline" role="listbox" aria-labelledby="lbl-timeline" tabindex="-1"><li role="option" id="dd-timeline-0" data-value="As soon as possible">As soon as possible</li><li role="option" id="dd-timeline-1" data-value="Within 1 month">Within 1 month</li><li role="option" id="dd-timeline-2" data-value="Within 1 to 3 months">Within 1 to 3 months</li><li role="option" id="dd-timeline-3" data-value="Within 3 to 6 months">Within 3 to 6 months</li><li role="option" id="dd-timeline-4" data-value="Just exploring options">Just exploring options</li></ul>
              </div>
            </div>
            <div class="field"><label for="f-msg">Project description</label><textarea id="f-msg" name="message" rows="5" placeholder="What are you trying to achieve, and what is getting in the way?" required></textarea></div>

            <div class="c-actions">
              <button class="c-send" type="submit"><span>Send message</span></button>
              <p class="c-legal">By submitting, you agree to the <a href="/terms">Terms</a> and <a href="/privacy">Privacy Policy</a>.</p>
            </div>
            <p class="c-status" role="status" aria-live="polite" data-cstatus></p>
          </form>
        </div>
      </div>
    </section>
